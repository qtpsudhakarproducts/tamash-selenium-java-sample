# Copy to .env and adjust. tamash-selenium reads system properties, then env vars, then .env.
# The sample already sets sensible defaults in pom.xml — you only need this to change the provider,
# point at a different app, or run headed.

# ---- healing provider -------------------------------------------------------
# Unset / "tamash" = the built-in rule-based provider: no key, no network, no tokens, never guesses.
HEALER_PROVIDER=tamash

# For AI-backed healing, pick one and fill in its keys instead:
# HEALER_PROVIDER=ollama
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_API_KEY=

# HEALER_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# HEALER_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# HEALER_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash    # 2.0/2.5-flash are retired — see ai.google.dev/gemini-api/docs/models
# GEMINI_API_KEY=

# Subscription providers — no API key, bill an existing plan (both verified with this sample):
# HEALER_PROVIDER=claude-subscription      # needs CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_SUBSCRIPTION_MODEL=claude-haiku-4-5

# HEALER_PROVIDER=copilot-subscription     # needs the `copilot` CLI installed & signed in
#                                          # (pom.xml already has the optional com.github:copilot-sdk-java)

# ---- browser --------------------------------------------------------------
TAMASH_BROWSER=chrome
HEADLESS=true

# ---- app under test -----------------------------------------------------
HRM_BASE_URL=https://qtpsudhakar-vibetestq-hrm.up.railway.app/
HRM_USERNAME=testadmin
HRM_PASSWORD=Vibetestq@123#
